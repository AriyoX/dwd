{
  "name": "dwd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "scripts": {
    "dev": "npm run dev --workspace @dwd/web",
    "deploy:check": "node --env-file-if-exists=apps/web/.env.production.local scripts/check-deployment.mjs",
    "build": "npm run build --workspace @dwd/core && npm run build --workspace @dwd/contracts && npm run build --workspace @dwd/data && npm run build --workspace @dwd/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:unit && npm run test:db",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "test:db": "node scripts/test-database.mjs",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vitest": "4.1.10"
  }
}
