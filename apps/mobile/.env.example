# Use the same dedicated Drink with Desire Supabase project as the web app.
# These are public client values. Never place a Supabase secret/service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_DWD_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
EXPO_PUBLIC_SITE_URL=https://dwdug.vercel.app
# EAS project UUID (public). Required for installed-build Expo push registration.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Apple Developer team ID used for signing and website association; no signing secrets here.
DWD_APPLE_TEAM_ID=
# EAS file variable pointing to Firebase's google-services.json for
# com.dwd.app. Set for preview and production Android builds.
GOOGLE_SERVICES_JSON=
