{
  "expo": {
    "name": "Drink with Desire",
    "slug": "drink-with-desire",
    "version": "0.1.0",
    "scheme": "dwd",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": ["expo-router", "expo-sqlite", "expo-status-bar", "expo-apple-authentication"],
    "ios": {
      "bundleIdentifier": "com.drinkwithdesire.mobile",
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "infoPlist": { "CADisableMinimumFrameDurationOnPhone": true }
    },
    "android": {
      "package": "com.drinkwithdesire.mobile"
    }
  }
}
