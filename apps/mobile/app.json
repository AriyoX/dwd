{
  "expo": {
    "name": "Drink with Desire",
    "slug": "drink-with-desire",
    "version": "0.1.0",
    "scheme": "dwd",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DWD uses your location on this device to choose local emergency numbers and holiday reminders. Coordinates are not sent to DWD. Without access, Uganda is used.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      ["expo-secure-store", { "configureAndroidBackup": true }],
      ["expo-build-properties", { "android": { "compileSdkVersion": 36, "targetSdkVersion": 36 } }],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to share with people from your night.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "bundleIdentifier": "com.dwd.app",
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.dwd.app",
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dd1a6538-e07e-47b2-baed-7d6d9f6c009b"
      }
    }
  }
}
