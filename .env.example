# Dedicated Drink with Desire project only. Never reuse Baby Steps credentials.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DWD_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# On Vercel, use your HTTPS production origin. Preview links use VERCEL_URL automatically.
# Run npm run deploy:check with apps/web/.env.production.local before deploying.

# Optional server-only secret for future administrative maintenance.
# The current MVP does not require it for normal user flows.
SUPABASE_SECRET_KEY=

# Browser push is disabled until all of these are configured. Keep the private
# key and dispatch secret server-only; the public key may be exposed to the web app.
NEXT_PUBLIC_DWD_VAPID_PUBLIC_KEY=
DWD_VAPID_PUBLIC_KEY=
DWD_VAPID_PRIVATE_KEY=
DWD_VAPID_SUBJECT=mailto:notifications@example.com
DWD_PUSH_DISPATCH_SECRET=
