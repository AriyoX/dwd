{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/web/src/*"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "apps/web/src/app/.well-known/**/*.ts",
    "apps/**/*.mjs",
    "packages/**/*.ts",
    "scripts/**/*.mjs",
    "tests/**/*.ts",
    "*.ts",
    "*.mjs"
  ],
  "exclude": ["node_modules", "apps/mobile"]
}
